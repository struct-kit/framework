# =============================================================================
# Struct Framework Environment Configuration
# =============================================================================

# Application Environment (development, production, test)
APP_ENV=development
APP_NAME=struct-framework
APP_DESCRIPTION="Typed-first secure Go microservice framework"
APP_VERSION=1.0.0
SERVICE_NAME=struct-framework
PORT=8080

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL, MySQL, or In-Memory)
# -----------------------------------------------------------------------------
# Select driver: "postgres", "mysql", or "memory" (zero external infrastructure)
DB_DRIVER=postgres

# Direct Connection URL (preferred)
DATABASE_URL=postgres://svc:secret@127.0.0.1:5432/svc?sslmode=disable
# For MySQL: mysql://svc:secret@127.0.0.1:3306/svc

# Optional Read Replica URL (routes heavy queries and reports)
DATABASE_REPLICA_URL=

# Discrete credentials fallback (used if DATABASE_URL is not specified):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=svc
# DB_PASSWORD=secret
# DB_NAME=svc
# DB_SSLMODE=disable

# Connection Pool Tuning
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# -----------------------------------------------------------------------------
# Asynchronous Message Broker & Outbox Relay
# -----------------------------------------------------------------------------
# Select driver: "memory", "redis", "nats", "kafka", or "log"
MESSAGE_BROKER=memory
BROKER_URL=redis://127.0.0.1:6379

# Embed transactional outbox polling relay inside API server
OUTBOX_RELAY_ENABLED=false

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# In production (APP_ENV=production), both keys are strictly required.
# In development, ephemeral keys are generated automatically on boot.
JWT_SIGNING_KEY=
ENCRYPTION_KEY=

# WebAuthn / Passkey Relying Party domain and origin
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# -----------------------------------------------------------------------------
# Internationalization (i18n)
# -----------------------------------------------------------------------------
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,es

# -----------------------------------------------------------------------------
# Observability, Profiling & Networking
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
RATE_LIMIT_RPS=20
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
PPROF_ENABLED=true

# Optional OpenTelemetry Protocol HTTP JSON span export endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
